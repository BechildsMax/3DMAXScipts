-- MaxZJTools 安装器：只注册本包 Loader，既有 Loader 保留备份。
(
    local installDir = getFilenamePath (getThisScriptFilename())
    local initPath = installDir + "startup\\MaxZJTools_Init.ms"
    local required = #("startup\\MaxZJTools_Init.ms", "config\\version.ini", "tools\\RenameTools.ms", "tools\\MeshChecker.ms", "tools\\ReSetTexturesPath.ms", "tools\\BoneOverride.ms", "tools\\VertexColorWriter.ms", "tools\\VertexColorWriterUI.cs", "tools\\VertexColorWriterTexture.cs", "tools\\ZHeightToVertexRed.ms")
    local fileAPI = dotNetClass "System.IO.File"
    local directoryAPI = dotNetClass "System.IO.Directory"
    local loaderFile = (getDir #userStartupScripts) + "\\MaxZJTools_Loader.ms"
    local token = ((dotNetClass "System.Guid").NewGuid()).ToString("N")
    local staged = loaderFile + "." + token + ".tmp"
    local backup = ""
    try
    (
        for relative in required do
            if not doesFileExist (installDir + relative) do throw ("包文件缺失：" + relative)
        local version = getINISetting (installDir + "config\\version.ini") "Version" "Version"
        if not ((dotNetClass "System.Text.RegularExpressions.Regex").IsMatch version "^[0-9]+\\.[0-9]+\\.[0-9]+$") do throw "版本信息无效。"
        directoryAPI.CreateDirectory (getDir #userStartupScripts)
        local content = "-- Generated by MaxZJTools installer\r\n(\r\n    local initPath = @\"" + initPath + "\"\r\n"
        content += "    if doesFileExist initPath then\r\n    (\r\n        try (fileIn initPath) catch (format \"[MaxZJTools] Startup failed: %\\n\" (getCurrentException()))\r\n    )\r\n"
        content += "    else format \"[MaxZJTools] Package moved or missing: %. Run Install.ms from the new package folder.\\n\" initPath\r\n)\r\n"
        fileAPI.WriteAllText staged content (dotNetObject "System.Text.UTF8Encoding" true)
        if fileAPI.ReadAllText staged != content do throw "Loader 写入回读不一致。"
        if fileAPI.Exists loaderFile then
        (
            backup = loaderFile + "." + token + ".bak"
            fileAPI.Replace staged loaderFile backup
        )
        else fileAPI.Move staged loaderFile
        if fileAPI.ReadAllText loaderFile != content do throw "安装后 Loader 回读不一致；请保留并检查备份。"
        local msg = "Loader 注册完成；尚未验证菜单加载。\n版本：" + version + "\n入口：" + loaderFile + "\n包目录需保持原位置：" + installDir
        if backup != "" do msg += "\n旧 Loader 备份：" + backup
        msg += "\n重启 Max 验证自动加载，或手动运行 startup/MaxZJTools_Init.ms。\n卸载：删除本 Loader 并重启；场景不会被恢复或删除。"
        messageBox msg title:"MaxZJTools 安装"
    )
    catch
    (
        local failure = getCurrentException()
        try (if fileAPI.Exists staged do fileAPI.Delete staged) catch (format "[MaxZJTools] 临时 Loader 清理失败：%\n" staged)
        if backup != "" do failure += "\n旧 Loader 备份：" + backup
        messageBox failure title:"MaxZJTools 安装未完成"
    )
)
